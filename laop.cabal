cabal-version: 3.0
name: laop
version: 0.2.0.0
synopsis: Matrix programming library
description:
  Matrix programming library that uses a type-safe inductive definition
  inspired by the Linear Algebra of Programming

homepage: https://github.com/bolt12/laop
bug-reports: https://github.com/bolt12/laop/issues
license: MIT
license-file: LICENSE
author: Armando Santos
maintainer: Armando Santos <armandoifsantos@gmail.com>
copyright: 2023 Armando Santos
category: Data
build-type: Simple
extra-doc-files:
  CHANGELOG.md
  README.md

tested-with: ghc ==9.10.3

source-repository head
  type: git
  location: https://github.com/bolt12/laop.git

common common-options
  build-depends: base >=4.20 && <5
  ghc-options:
    -- -Wno-duplicate-exports: ghc considers exporting f and f' the same name
    -Wall
    -Wno-unticked-promoted-constructors
    -Wcompat
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wpartial-fields
    -Widentities
    -Wredundant-constraints
    -Wunused-packages
    -fhide-source-paths
    -Wmissing-export-lists
    -Wno-duplicate-exports

  default-language: GHC2024

common executable-options
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

library
  import: common-options
  hs-source-dirs: src
  build-depends:
    array >=0.5.8 && <0.6,
    deepseq >=1.5 && <1.6,
    parallel >=3.2 && <3.3,

  exposed-modules:
    LAoP.Dist
    LAoP.Dist.Internal
    LAoP.Matrix.Indexed
    LAoP.Matrix.Internal
    LAoP.Matrix.Nat
    LAoP.Matrix.Parallel
    LAoP.Matrix.Parallel.Indexed
    LAoP.Matrix.Parallel.Nat
    LAoP.Matrix.Type
    LAoP.Relation
    LAoP.Relation.Internal
    LAoP.Utils
    LAoP.Utils.Internal

  other-modules: LAoP.Matrix.Dim

test-suite laop-test
  import: common-options, executable-options
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  other-modules:
    Examples.Readme
    Examples.Spreadsheets

  main-is: Spec.hs
  build-depends: laop

benchmark laop-benchmark
  import: common-options, executable-options
  type: exitcode-stdio-1.0
  hs-source-dirs: benchmark
  main-is: Main.hs
  build-depends:
    QuickCheck,
    criterion,
    deepseq,
    laop,
